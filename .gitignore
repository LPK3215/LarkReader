# Node / Vite
/node_modules/
/dist/
/dist-ssr/
*.tsbuildinfo
# Lockfiles: package-lock.json is authoritative (npm); pnpm lockfile is not used
pnpm-lock.yaml

# Rust / Tauri generated output
/src-tauri/target/
/src-tauri/gen/schemas/

# Logs
/logs/
*.log
# Persisted E2E case snapshot keeps its .log fixture (04_app.log)
!docs/e2e-download-case/06_附件下载/04_app.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment and machine-specific configuration
.env
.env.*
!.env.example
*.local

# Editors and IDEs
/.vscode/*
!/.vscode/extensions.json
/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and patch files
*.tmp
*.temp
*.bak
*.orig
*.rej

# Rust / Cargo build artifacts not covered by target/
*.pdb
**/*.rs.bk

# Tauri locally generated code (iOS / Android projects, local bindings, etc.)
/src-tauri/gen/

# Frontend / tooling caches
.vite/
.turbo/
.coverage/
.nyc_output/
.eslintcache
.stylelintcache

# AI assistant local state (session memory, automations, logs — not source)
.codebuddy/
.workbuddy/

# E2E download working directory (cleared before each test run;
# the persisted case snapshot lives in docs/e2e-download-case/)
/e2e_download_tmp/
/e2e_download_tmp_big/